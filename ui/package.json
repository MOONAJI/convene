{
  "name": "convene",
  "version": "0.1.0",
  "proxy": "http://localhost:7575",
  "private": true,
  "dependencies": {
    "@daml.js/convene": "file:daml.js/convene-0.1.0",
    "@daml/hub-react": "^1.0.0",
    "@daml/ledger": "2.10.6",
    "@daml/react": "2.10.6",
    "@daml/types": "2.10.6",
    "dotenv": "^8.2.0",
    "jwt-simple": "^0.5.6",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "semantic-ui-css": "^2.4.1",
    "semantic-ui-react": "^2.0.0"
  },
  "scripts": {
    "css:build": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/generated.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/generated.css --watch=always",
    "start": "npm run css:build && (npm run css:watch & react-scripts --openssl-legacy-provider start)",
    "build": "npm run css:build && react-scripts --openssl-legacy-provider build",
    "test": "react-scripts test --testURL='http://127.0.0.1:7575'",
    "eject": "react-scripts eject",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/jwt-simple": "^0.5.33",
    "@types/minimatch": "5.1.2",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "autoprefixer": "^10.6.1",
    "eslint-config-react-app": "^7.0.1",
    "http-proxy-middleware": "^1.0.4",
    "postcss": "^8.5.28",
    "react-scripts": "^4.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~3.8.3"
  },
  "overrides": {
    "react-error-overlay": "6.0.9"
  }
}
